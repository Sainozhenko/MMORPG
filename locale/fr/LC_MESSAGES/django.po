#: templates/account/password_reset.html:7
#: templates/account/password_reset_done.html:7
msgid "Password Reset"
msgstr "Réinitialisation du mot de passe"

#: templates/account/password_reset.html:10
msgid ""
"Forgotten your password? Enter your email address below, and we'll send you "
"an email allowing you to reset it."
msgstr ""
"Mot de passe oublié ? Saisissez votre adresse e-mail ci-dessous, et nous vous "
"enverrons un e-mail vous permettant de le réinitialiser."

#: templates/account/password_reset.html:29
msgid "Reset My Password"
msgstr "Réinitialiser mon mot de passe"

#: templates/account/password_reset.html:34
#: templates/account/password_reset_done.html:14
msgid "Back to Login"
msgstr "Retour à la connexion"

#: templates/account/password_reset_done.html:10
msgid ""
"We have sent you an email. If you have not received it please check your "
"spam folder. Otherwise contact us if you do not receive it in a few minutes."
msgstr ""
"Nous vous avons envoyé un e-mail. Si vous ne l'avez pas reçu, veuillez vérifier "
"votre dossier de courrier indésirable. Sinon, contactez-nous si vous ne le "
"recevez pas dans quelques minutes."

#: templates/account/password_reset_from_key.html:7
msgid "Set New Password"
msgstr "Définir un nouveau mot de passe"

#: templates/account/password_reset_from_key.html:28
msgid "New Password"
msgstr "Nouveau mot de passe"

#: templates/account/password_reset_from_key.html:33
msgid "New Password (again)"
msgstr "Nouveau mot de passe (confirmation)"

#: templates/account/password_reset_from_key.html:38
msgid "Change Password"
msgstr "Changer le mot de passe"

#: templates/account/password_reset_from_key_done.html:7
msgid "Password Changed"
msgstr "Mot de passe changé"

#: templates/account/password_reset_from_key_done.html:9
msgid ""
"Your password has been successfully updated. You can now log in with your "
"new credentials."
msgstr ""
"Votre mot de passe a été mis à jour avec succès. Vous pouvez maintenant vous "
"connecter avec vos nouveaux identifiants."

#: templates/account/password_reset_from_key_done.html:12
msgid "Go to Login"
msgstr "Aller à la page de connexion"

#: templates/account/signup.html:7
msgid "Create Account"
msgstr "Créer un compte"

#: templates/account/signup.html:14
msgid "Please correct the errors below."
msgstr "Veuillez corriger les erreurs ci-dessous."

#: templates/account/signup.html:47
msgid "Already have an account?"
msgstr "Vous avez déjà un compte ?"

#: templates/account/verification_sent.html:10
msgid "Verify Your Email Address"
msgstr "Vérifiez votre adresse e-mail"

#: templates/account/verification_sent.html:14
msgid ""
"We have sent an e-mail to you for verification. Please check your inbox (and "
"spam folder if you do not receive it shortly)."
msgstr ""
"We have sent an e-mail to you for verification. Please check your inbox "
"(and spam folder if you do not receive it shortly)."

#: templates/account/verification_sent.html:18
msgid "Back to Home"
msgstr "BACK TO HOME"

